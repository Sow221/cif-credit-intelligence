# =============================================================
# CIF CREDIT INTELLIGENCE — .gitignore professionnel
# Le code, la config, la documentation et les rapports sont
# versionnés. Les données et artefacts volumineux sont gérés
# par DVC (hors git). Aucun secret ne doit être commité.
# =============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.so
.ipynb_checkpoints/
*.ipynb  # notebooks ne sont pas des sources reproductibles ; on versionne les scripts
!.ipynb_checkpoints/

# ---------- Environnements / dépendances ----------
.venv/
venv/
env/
.conda/
*.egg
.python-version

# ---------- Outils ML / Data ----------
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.mlruns/
mlruns/
.dvc/tmp/
.dvc/cache/
mlartifacts/

# ---------- Données & artefacts volumineux (gérés par DVC) ----------
# data/ et models/ : les fichiers lourds (csv, joblib) sont versionnés par DVC, pas git.
# Ré-inclusion des dossiers pour garder les références légères versionnées
#   (feature_columns.json, model_registry.json, .gitkeep, README d'archive).
data/*
!data/.gitkeep
!data/raw/
!data/processed/
!data/external/
!data/cif_real/
!data/test_adversarial/
!data/archived/
# à l'intérieur des dossiers data ré-inclus, ignore les artefacts lourds
data/**/*.csv
data/**/*.joblib
data/**/*.pkl
data/**/*.parquet

models/*
!models/.gitkeep
!models/trained/
!models/registry/
# à l'intérieur des dossiers models ré-inclus, ignore les artefacts lourds
models/**/*.joblib
models/**/*.pkl
models/**/*.pickle
models/**/*.onnx

# Extensions binaires/masses génériques
*.csv
*.joblib
*.pkl
*.pickle
*.parquet
*.feather
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.zip

# ---------- Secrets / config locale ----------
.env
.env.*
!.env.example
*.local
*.secret

# ---------- OS / éditeurs ----------
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---------- Divers ----------
*.log
logs/
tmp/
.tmp/
*.bak
*.tmp
