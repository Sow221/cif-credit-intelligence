# =============================================================
# CIF CREDIT INTELLIGENCE — .gitignore professionnel
# Le code, la config, la documentation et les rapports sont
# versionnés. Les données et artefacts volumineux sont gérés
# par DVC (hors git). Aucun secret ne doit être commité.
# =============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.so
.ipynb_checkpoints/

# ---------- Environnements / dépendances ----------
.venv/
venv/
env/
.conda/
*.egg
uv.lock
poetry.lock
Pipfile.lock
.python-version

# ---------- Outils ML / Data ----------
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.mlruns/
mlruns/
.dvc/tmp/
.dvc/cache/

# ---------- Données & artefacts volumineux (gérés par DVC) ----------
# Ne pas commiter les CSV bruts/traités ni les modèles binaires
*.csv
*.joblib
*.pkl
*.pickle
*.parquet
*.feather
*.h5
*.hdf5
*.onnx
*.pt
*.pth

# ---------- Idées : on garde les rapports et figures ----------
# (les figures/résultats générés sont versionnés comme preuves)
# !reports/figures/
# !reports/metrics/

# ---------- Secrets / config locale ----------
.env
.env.*
!.env.example
*.local
*.secret

# ---------- OS / éditeurs ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Divers ----------
*.log
logs/
tmp/
.tmp/
*.bak
*.tmp
