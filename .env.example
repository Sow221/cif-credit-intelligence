# CIF Credit Intelligence — Backend (.env)
# Copier ce fichier vers .env et adapter aux valeurs de l'environnement.

# --- Modèle ---
# Chemin relatif depuis la racine du projet vers l'artefact ML.
MODEL_PATH=mlops/artifacts/MODEL_OFFICIAL.joblib
# URI du modèle (MLflow Registry). Non renseigné = chargement depuis MODEL_PATH
# (fallback fichier). Exemple quand un serveur puissant est disponible :
# MODEL_URI=models:/microcredit_risk/Production

# --- Sécurité / Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Base de données (driver psycopg v3) ---
DATABASE_URL=postgresql+psycopg://cif:cif@localhost:5440/cif

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limits (requêtes / minute) ---
RATE_PREDICT=60
RATE_DECISIONS=30
RATE_AUDIT=30
RATE_MODELS=60
RATE_DRIFT=5
RATE_HEALTH=120
RATE_OVERRIDE=10

# --- Tracking : W&B Cloud (actif par défaut) ---
# MLflow est en code de repli (opt-in via --mlflow). W&B est le tracking
# actif : se connecter via `wandb login` (API key) avant l'entraînement.
WANDB_PROJECT=cif-credit-intelligence

# --- MLflow (opt-in, serveur puissant uniquement) : voir --mlflow ---
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Frontend (build Vite) ---
# URL de base de l'API (vide = même origine, proxy nginx /v1)
VITE_API_BASE_URL=
