# CIF Credit Intelligence — Backend
# Copier vers .env et adapter.

# Modèle
MODEL_PATH=./02_MODELS/trained/MODEL_OFFICIAL.joblib

# Sécurité / Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Base de données
DATABASE_URL=postgresql+psycopg2://cif:cif@localhost:5432/cif

# Cache / Rate limit
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
